// backend/prisma/models/system/databaseBackup.prisma

enum DatabaseBackupType {
  MANUAL
  DAILY
  WEEKLY
  PRE_RESTORE
}

enum DatabaseBackupStatus {
  PENDING
  SUCCESS
  FAILED
}

model DatabaseBackup {
  id          String               @id @default(cuid())
  type        DatabaseBackupType
  status      DatabaseBackupStatus @default(PENDING)
  fileKey     String
  fileUrl     String?
  fileName    String
  sizeBytes   BigInt?
  startedAt   DateTime             @default(now())
  finishedAt  DateTime?
  error       String?              @db.Text
  triggeredBy String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([type, createdAt])
  @@index([status])
  @@map("database_backups")
}
