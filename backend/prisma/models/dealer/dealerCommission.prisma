enum DealerCommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

/// Comisión comercial por venta de vehículo (Doc §23.2 / §27).
/// Se genera al cerrar/convertir la venta, usando la comisión base de DealerPolicy
/// (o un porcentaje específico). Permite calcular el KPI de comisiones y desempeño.
model DealerCommission {
  id            String   @id @default(uuid())

  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id_empresa], onDelete: Restrict)

  dealerQuoteId String?
  dealerQuote   DealerQuote? @relation(fields: [dealerQuoteId], references: [id], onDelete: SetNull)

  salesOrderId  String?

  sellerId      String?
  sellerName    String?

  baseAmount    Decimal  @db.Decimal(14, 2)
  commissionPct Decimal  @db.Decimal(6, 2)
  commissionAmount Decimal @db.Decimal(14, 2)
  currency      OrderCurrency @default(USD)

  status        DealerCommissionStatus @default(PENDING)
  paidAt        DateTime?
  notes         String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("dealer_commissions")
  @@index([empresaId])
  @@index([dealerQuoteId])
  @@index([sellerId])
  @@index([status])
  @@index([isActive])
}
