enum DealerQuoteStatus {
  DRAFT
  SENT
  NEGOTIATING
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum DealerExchangeRateSource {
  BCV_AUTO
  MANUAL
}

enum DealerFiscalStatus {
  NOT_REQUESTED
  ORDER_DRAFT
  ORDER_APPROVED
  PREINVOICE_READY
  PAID
  INVOICED
  ERROR
}

model DealerQuote {
  id                String             @id @default(uuid())

  empresaId          String
  empresa            Empresa            @relation(fields: [empresaId], references: [id_empresa], onDelete: Restrict)

  dealerUnitId       String
  dealerUnit         DealerUnit         @relation(fields: [dealerUnitId], references: [id], onDelete: Restrict)

  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)

  quoteNumber        String
  status             DealerQuoteStatus  @default(DRAFT)

  customerName       String
  customerDocument   String?
  customerPhone      String?
  customerEmail      String?

  listPrice          Decimal?           @db.Decimal(14, 2)
  discountPct        Decimal?           @db.Decimal(6, 2)
  discountAmount     Decimal?           @db.Decimal(14, 2)
  offeredPrice       Decimal?           @db.Decimal(14, 2)
  taxPct             Decimal?           @db.Decimal(6, 2)
  taxAmount          Decimal?           @db.Decimal(14, 2)
  totalAmount        Decimal?           @db.Decimal(14, 2)
  // Componentes adicionales del negocio (Doc §10.2)
  accessoriesTotal   Decimal?           @db.Decimal(14, 2)
  adminFees          Decimal?           @db.Decimal(14, 2)
  tradeInValue       Decimal?           @db.Decimal(14, 2)
  requiredDeposit    Decimal?           @db.Decimal(14, 2)
  grandTotal         Decimal?           @db.Decimal(14, 2)
  currentVersion     Int                @default(1)
  currency           OrderCurrency      @default(USD)
  exchangeRate       Decimal?           @db.Decimal(14, 4)
  exchangeRateSource DealerExchangeRateSource?
  fiscalStatus       DealerFiscalStatus @default(NOT_REQUESTED)
  fiscalError        String?
  salesOrderId       String?            @unique
  salesOrder         Order?             @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  preInvoiceId       String?            @unique
  preInvoice         PreInvoice?        @relation(fields: [preInvoiceId], references: [id], onDelete: SetNull)
  invoiceId          String?            @unique
  invoice            Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  validUntil         DateTime?
  paymentTerms       String?
  financingRequired  Boolean            @default(false)
  notes              String?
  isActive           Boolean            @default(true)

  sentAt             DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  convertedAt        DateTime?

  commissions        DealerCommission[]
  accessories        DealerQuoteAccessory[]
  versions           DealerQuoteVersion[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("dealer_quotes")
  @@index([empresaId])
  @@index([dealerUnitId])
  @@index([customerId])
  @@index([status])
  @@index([fiscalStatus])
  @@index([empresaId, fiscalStatus])
  @@index([salesOrderId])
  @@index([preInvoiceId])
  @@index([isActive])
  @@index([createdAt])
  @@unique([empresaId, quoteNumber])
}
