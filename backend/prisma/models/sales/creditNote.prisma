// backend/prisma/models/sales/creditNote.prisma

enum CreditNoteStatus {
  DRAFT    // Borrador
  ACTIVE   // Emitida
  CANCELLED // Anulada
}

model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String           @unique
  status           CreditNoteStatus @default(DRAFT)

  empresaId        String
  empresa          Empresa          @relation(fields: [empresaId], references: [id_empresa], onDelete: Restrict)

  invoiceId        String
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items            CreditNoteItem[]

  reason           String           @db.Text

  // ── Moneda ──
  currency         OrderCurrency    @default(USD)
  exchangeRate     Decimal?         @db.Decimal(14, 4)

  // ── Descuento general ──
  discountAmount   Decimal          @default(0) @db.Decimal(12, 2)

  // ── Totales fiscales ──
  subtotalBruto    Decimal          @default(0) @db.Decimal(12, 2)
  baseImponible    Decimal          @default(0) @db.Decimal(12, 2)
  baseExenta       Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(12, 2)
  taxRate          Decimal          @default(16) @db.Decimal(5, 2)

  // ── IGTF ──
  igtfApplies      Boolean          @default(false)
  igtfRate         Decimal          @default(3) @db.Decimal(5, 2)
  igtfAmount       Decimal          @default(0) @db.Decimal(12, 2)

  // ── Total ──
  total            Decimal          @default(0) @db.Decimal(12, 2)

  notes            String?          @db.Text

  // Auditoría
  issuedBy         String?
  issuedAt         DateTime?

  // Anulación
  cancelledAt      DateTime?
  cancelledBy      String?
  cancellationReason String?        @db.Text

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("credit_notes")
  @@index([creditNoteNumber])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([empresaId])
}

model CreditNoteItem {
  id             String     @id @default(uuid())

  creditNoteId   String
  creditNote     CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  itemId         String?
  item           Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)

  itemName       String?    @db.VarChar(255)
  quantity       Int
  unitPrice      Decimal    @db.Decimal(12, 2)

  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(12, 2)

  taxType        TaxType    @default(IVA)
  taxRate        Decimal    @default(16) @db.Decimal(5, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)

  subtotal       Decimal    @db.Decimal(12, 2)
  totalLine      Decimal    @default(0) @db.Decimal(12, 2)

  createdAt      DateTime   @default(now())

  @@map("credit_note_items")
  @@index([creditNoteId])
  @@index([itemId])
}
