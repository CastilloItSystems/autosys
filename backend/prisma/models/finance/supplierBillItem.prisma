// backend/prisma/models/finance/supplierBillItem.prisma

model SupplierBillItem {
  id             String       @id @default(cuid())

  supplierBillId String
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)

  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  // Snapshot histórico de la factura
  itemName       String?      @db.VarChar(255)

  quantity       Int
  unitCost       Decimal      @db.Decimal(12, 2)

  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)

  taxType        TaxType      @default(IVA)
  taxRate        Decimal      @default(16) @db.Decimal(5, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(12, 2)

  subtotal       Decimal      @db.Decimal(12, 2)
  totalLine      Decimal      @default(0) @db.Decimal(12, 2)

  notes          String?      @db.Text

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("supplier_bill_items")
  @@index([supplierBillId])
  @@index([itemId])
}
