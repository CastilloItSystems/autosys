// backend/prisma/models/finance/expenseRecurringRule.prisma

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model ExpenseRecurringRule {
  id          String             @id @default(cuid())
  name        String             // "Internet Inter mensual"
  category    ExpenseCategory
  description String
  isActive    Boolean            @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  amount      Decimal               @db.Decimal(12, 2)
  currency    PurchaseOrderCurrency @default(USD)
  frequency   RecurringFrequency
  dayOfMonth  Int?                  // 1-31 para mensuales/anuales
  startDate   DateTime
  endDate     DateTime?
  nextRunDate DateTime              // calculado, actualizado tras cada generación

  generatedExpenses Expense[]

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id_empresa], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expense_recurring_rules")
  @@index([empresaId, isActive, nextRunDate])
}
